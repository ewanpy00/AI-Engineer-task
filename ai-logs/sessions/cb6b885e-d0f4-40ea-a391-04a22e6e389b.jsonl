lalchemy.exc.OperationalError) as exc:\n            pytest.skip(f\"Postgres недоступен: {exc}\")\n\n\nasync def test_status_page_renders_current_state():\n    running_state()\n\n    response = await get_status()\n\n    assert response.status_code == 200\n    assert TITLE in response.text          # текущая игра\n    assert \"идёт заход\" in response.text    # статус воркера\n    assert \"#42\" in response.text and \"browse\" in response.text\n\n\nasync def test_status_page_shows_events_from_the_buffer():\n    \"\"\"Клиент, открывший страницу посреди захода, видит уже случившееся.\"\"\"\n    get_bus().publish(Event(kind=\"game_done\", payload={\"slug\": \"zzq\", \"title\": TITLE}))\n\n    assert TITLE in (await get_status()).text\n\n\nasync def test_status_page_carries_the_admin_token_for_the_button():\n    \"\"\"Без токена кнопка была бы неработающей декорацией (OQ-8).\"\"\"\n    from app.config import get_settings\n\n    text = (await get_status()).text\n    assert 'hx-post=\"/admin/run\"' in text\n    assert get_settings().admin_token in text\n\n\nasync def read_frame(lines) -> str:\n    \"\"\"Один SSE-кадр: строки до пустой.\"\"\"\n    frame: list[str] = []\n    while True:\n        line = await asyncio.wait_for(anext(lines), timeout=2)\n        if line == \"\":\n            return \"\\n\".join(frame)\n        frame.append(line)\n\n\nasync def test_events_stream_opens_with_the_current_panel():\n    running_state()\n\n    async with client() as http:\n        async with http.stream(\"GET\", \"/events\") as response:\n            assert response.headers[\"content-type\"].startswith(\"text/event-stream\")\n            assert response.headers[\"cache-control\"] == \"no-cache\"\n\n            frame = await read_frame(response.aiter_lines())\n\n    assert frame.startswith(\"event: panel\")\n    assert TITLE in frame\n\n\nasync def test_events_stream_pushes_every_new_event():\n    running_state()\n\n    async with client() as http:\n        async with http.stream(\"GET\", \"/events\") as response:\n            lines = response.aiter_lines()\n            await read_frame(lines)  # первичная панель\n\n            get_bus().publish(Event(kind=\"game_failed\", payload={\"slug\": \"zzq\", \"title\": TITLE,\n                                                                 \"error\": \"boom\"}))\n            feed = await read_frame(lines)\n            panel = await read_frame(lines)\n\n    assert feed.startswith(\"event: feed\")\n    assert TITLE in feed and \"boom\" in feed\n    # панель приходит следом уже с новым счётчиком ошибок\n    assert panel.startswith(\"event: panel\")\n    assert \"ошибок 1\" in panel\n\n\nasync def test_events_stream_pings_when_nothing_happens(monkeypatch):\n    \"\"\"Идлящийся стрим прокси Railway рвёт — держим его комментарием (ADR-5).\"\"\"\n    monkeypatch.setattr(routes_status, \"KEEPALIVE_S\", 0.05)\n\n    async with client() as http:\n        async with http.stream(\"GET\", \"/events\") as response:\n            lines = response.aiter_lines()\n            await read_frame(lines)  # первичная панель\n\n            assert await read_frame(lines) == \": ping\"\n\n\nasync def test_disconnect_releases_the_subscription():\n    \"\"\"Закрытая вкладка не должна оставлять за собой очередь на шине.\"\"\"\n    bus = get_bus()\n    async with client() as http:\n        async with http.stream(\"GET\", \"/events\") as response:\n            await read_frame(response.aiter_lines())\n            assert bus.subscribers == 1\n\n    # генератор закрывается вместе с ответом, подписка снимается в его finally\n    await asyncio.sleep(0)\n    assert bus.subscribers == 0\n\n\ndef test_multiline_html_survives_the_sse_frame_format():\n    \"\"\"Каждая строка HTML — своя `data:`; иначе браузер получит обрезанный кадр.\"\"\"\n    frame = routes_status.frame(\"feed\", \"<li>\\n  первая\\n  вторая\\n</li>\\n\")\n\n    assert frame == \"event: feed\\ndata: <li>\\ndata:   первая\\ndata:   вторая\\ndata: </li>\\n\\n\"\n\n\ndef test_event_frame_escapes_untrusted_text():\n    \"\"\"Ошибка из внешнего мира не имеет права стать разметкой.\"\"\"\n    event = Event(kind=\"game_failed\",\n                  payload={\"slug\": \"zzq\", \"title\": \"<script>\", \"error\": \"<b>boom</b>\"},\n                  ts=datetime.now(UTC))\n\n    frame = routes_status.event_frame(event)\n\n    assert \"<script>\" not in frame and \"&lt;script&gt;\" in frame\n    assert \"<b>boom</b>\" not in frame\nPY\n.venv/bin/python -m pytest tests/test_web_status.py -q 2>&1 | tail -25","description":"Write status web tests"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1435,"cache_read_input_tokens":134867,"output_tokens":3006,"output_tokens_details":{"thinking_tokens":669},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1435,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3006,"cache_read_input_tokens":134867,"cache_creation_input_tokens":1435,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1435},"type":"message"}],"speed":"standard"},"diagnostics":null},"apiBlockIndex":1,"requestId":"req_011CenaJtzWfK6p8PSBbHrRA","type":"assistant","uuid":"71c9c884-8228-49f8-a1c4-8b9d7403c637","timestamp":"2026-09-06T17:25:04.519Z","effort":"high","session_id":"5f8e1778-e48b-42dd-ae24-619dbd631c2d","userType":"external","entrypoint":"cli","cwd":"/Users/ivan/Desktop/testing_task","sessionId":"cb6b885e-d0f4-40ea-a391-04a22e6e389b","version":"2.1.263","gitBranch":"main"}
