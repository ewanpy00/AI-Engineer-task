{"parentUuid":"27078533-361c-4f05-b8e0-77cff26676fd","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/ivan/Desktop/testing_task/app/ingest/runner.py","snippet":"1\t\"\"\"Оркестратор одного захода (T-22, design §2.3, §4.3).\n2\t\n3\tЗаход = advisory lock + фиксированный день + батч из селектора + обработка игр\n4\t+ строка в `runs`. Резюме отзывов (T-30) подключено внутрь `process_game`\n5\tотдельным best-effort шагом; летсплея (T-45) здесь пока нет, он добавляется\n6\tтуда же и по тому же принципу: обогащение не решает судьбу игры в\n7\t`processed_games`.\n8\t\n9\tКаждый шаг захода публикует событие (T-35): одно и то же событие двигает\n10\t`WorkerState` и уходит в SSE, поэтому счётчики на странице статуса и лента\n11\tсобытий не могут разойтись. Мониторинг — наблюдатель: сбой публикации не\n12\tимеет права ни уронить заход, ни изменить его исход.\n13\t\n14\tДень фиксируется один раз на весь заход: обход, начавшийся в 23:59, должен\n15\tцеликом лечь в свои сутки, иначе claim и курсор разъедутся.\n16\t\"\"\"\n17\t\n18\tfrom __future__ import annotations\n19\t\n20\timport asyncio\n21\timport hashlib\n22\timport logging\n23\tfrom contextlib import asynccontextmanager\n24\tfrom dataclasses import dataclass\n25\tfrom datetime import UTC, date, datetime\n26\tfrom typing import AsyncIterator, Literal\n27\t\n28\tfrom sqlalchemy import text\n29\t\n30\tfrom app.clients.dto import CatalogItem, Product, ScoreStats\n31\tfrom app.clients.metacritic import MetacriticClient\n32\tfrom app.db import get_engine\n33\tfrom app.events import Event, EventBus, EventKind, get_bus\n34\tfrom app.ingest.day_cursor_repo import DayCursorRepo\n35\tfrom app.ingest.processed_repo import ProcessedRepo\n36\tfrom app.ingest.selector import BatchSelector\n37\tfrom app.ingest.upsert import upsert_game\n38\tfrom app.llm.gemini_client import GeminiClient, get_llm_client\n39\tfrom app.llm.review_pipeline import Outcome, summarize_game_reviews\n40\tfrom app.state import WorkerState, get_state\n41\t\n42\tlog = logging.getLogger(__name__)\n43\t\n44\tTrigger = Literal[\"schedule\", \"manual\"]\n45\tRunStatus = Literal[\"ok\", \"empty\", \"failed\", \"skipped_locked\"]\n46\t\n47\tCONCURRENCY = 4  # поверх глобального лимита клиента в 1 rps: параллелизм скрывает задержки БД\n48\tERROR_LIMIT = 1000\n49\t\n50\t# Ключ advisory-локи: детерминированный bigint из имени, чтобы не пересечься\n51\t# с чужими локами в той же базе.\n52\tLOCK_KEY = int.from_bytes(\n53\t    hashlib.sha256(b\"metacritic-digest:ingest\").digest()[:8], \"big\", signed=True\n54\t)\n55\t\n56\t\n57\t@dataclass(frozen=True)\n58\tclass GameResult:\n59\t    item: CatalogItem\n60\t    ok: bool\n61\t    game_id: int | None = None\n62\t    error: str | None = None\n63\t    # обогащение считается отдельно от `ok`: игра остаётся успешной, даже если\n64\t    # модель не ответила (design §5.5)\n65\t    llm: Outcome = Outcome()\n66\t\n67\t\n68\t@dataclass(frozen=True)\n69\tclass RunResult:\n70\t    day: date\n71\t    trigger: Trigger\n72\t    status: RunStatus\n73\t    run_id: int | None = None\n74\t    phase: str | None = None\n75\t    pages_fetched: int = 0\n76\t    games_claimed: int = 0\n77\t    games_ok: int = 0\n78\t    games_failed: int = 0\n79\t    llm_calls: int = 0\n80\t    llm_failures: int = 0\n81\t    error: str | None = None\n82\t\n83\t\n84\t_INSERT_RUN = text(\n85\t    \"INSERT INTO runs (day, trigger, status) VALUES (:day, :trigger, 'running') RETURNING id\"\n86\t)\n87\t_INSERT_SKIPPED = text(\n88\t    \"INSERT INTO runs (day, trigger, status, finished_at) \"\n89\t    \"VALUES (:day, :trigger, 'skipped_locked', now())\"\n90\t)\n91\t_UPDATE_BATCH = text(\n92\t    \"UPDATE runs SET phase = :phase, pages_fetched = :pages, games_claimed = :claimed \"\n93\t    \"WHERE id = :id\"\n94\t)\n95\t_FINISH_RUN = text(\n96\t    \"\"\"\n97\t    UPDATE runs SET\n98\t        status = :status, phase = :phase, pages_fetched = :pages,\n99\t        games_claimed = :claimed, games_ok = :ok, games_failed = :failed,\n100\t        llm_calls = :llm_calls, llm_failures = :llm_failures,\n101\t        finished_at = now(), error = :error\n102\t    WHERE id = :id\n103\t    \"\"\"\n104\t)\n105\t_TRY_LOCK = text(\"SELECT pg_try_advisory_lock(:key)\")\n106\t_UNLOCK = text(\"SELECT pg_advisory_unlock(:key)\")\n107\t\n108\t\n109\t@asynccontextmanager\n110\tasync def advisory_lock(key: int = LOCK_KEY) -> AsyncIterator[bool]:\n111\t    \"\"\"Держит сессионную advisory-локу на отдельном соединении.\n112\t\n113\t    Соединение нужно своё и на весь заход: лока живёт в сессии Postgres, а\n114\t    соединение из пула вернулось бы туда сразу после запроса. AUTOCOMMIT —\n115\t    чтобы не таскать за собой открытую транзакцию всё время обхода.\n116\t    \"\"\"\n117\t    acquired = False\n118\t    conn = await get_engine().connect()\n119\t    try:\n120\t        conn = await conn.execution_options(isolation_level=\"AUTOCOMMIT\")\n121\t        acquired = bool(await conn.scalar(_TRY_LOCK, {\"key\": key}))\n122\t        yield acquired\n123\t    finally:\n124\t        try:\n125\t            if acquired:\n126\t                await conn.scalar(_UNLOCK, {\"key\": key})\n127\t        finally:\n128\t            await conn.close()\n129\t\n130\t\n131\tasync def fetch_user_scores(\n132\t    client: MetacriticClient, product: Product\n133\t) -> dict[str, ScoreStats | None]:\n134\t    \"\"\"Userscore по каждой платформе игры — отдельный вызов на платформу.\n135\t\n136\t    Решение владельца: Userscore по всем платформам, отзывы — только по ведущей.\n137\t    \"\"\"\n138\t    return {\n139\t        platform.slug: await client.get_score_stats(product.slug, platform.slug, \"user\")\n140\t        for platform in product.platforms\n141\t    }\n142\t\n143\t\n144\tclass IngestRunner:\n145\t    \"\"\"Реализация `IngestRunner` из design §4.3.\n146\t\n147\t    Живёт на всё время процесса: и планировщик (T-23), и ручной запуск дёргают\n148\t    один и тот же экземпляр, поэтому глобальный лимит в 1 rps общий на все\n149\t    заходы, а не на каждый свой.\n150\t    \"\"\"\n151\t\n152\t    def __init__(\n153\t        self,\n154\t        client: MetacriticClient | None = None,\n155\t        cursor_repo: DayCursorRepo | None = None,\n156\t        processed_repo: ProcessedRepo | None = None,\n157\t        *,\n158\t        concurrency: int = CONCURRENCY,\n159\t        llm: GeminiClient | None = None,\n160\t        bus: EventBus | None = None,\n161\t        state: WorkerState | None = None,\n162\t    ) -> None:\n163\t        self._client = client\n164\t        self._cursors = cursor_repo or DayCursorRepo()\n165\t        self._processed = processed_repo or ProcessedRepo()\n166\t        self._concurrency = concurrency\n167\t        self._llm = llm\n168\t        self._bus = bus or get_bus()\n169\t        self._state = state or get_state()\n170\t\n171\t    @property\n172\t    def client(self) -> MetacriticClient:\n173\t        if self._client is None:\n174\t            self._client = MetacriticClient()\n175\t        return self._client\n176\t\n177\t    @property\n178\t    def llm(self) -> GeminiClient:\n179\t        \"\"\"Адаптер LLM создаётся лениво: заход без резюме ключа не требует.\"\"\"\n180\t        if self._llm is None:\n181\t            self._llm = get_llm_client()\n182\t        return self._llm\n183\t\n184\t    async def run(self, trigger: Trigger = \"schedule\") -> RunResult:\n185\t        day = datetime.now(UTC).date()\n186\t        async with advisory_lock() as acquired:\n187\t            if not acquired:\n188\t                log.info(\"заход %s пропущен: обход уже идёт\", trigger)\n189\t                async with get_engine().begin() as conn:\n190\t                    await conn.execute(_INSERT_SKIPPED, {\"day\": day, \"trigger\": trigger})\n191\t                return RunResult(day=day, trigger=trigger, status=\"skipped_locked\")\n192\t            return await self._run_locked(day, trigger)\n193\t\n194\t    async def _run_locked(self, day: date, trigger: Trigger) -> RunResult:\n195\t        async with get_engine().begin() as conn:\n196\t            run_id = int(await conn.scalar(_INSERT_RUN, {\"day\": day, \"trigger\": trigger}))\n197\t        log.info(\"заход #%s (%s) за %s начат\", run_id, trigger, day)\n198\t\n199\t        phase: str | None = None\n200\t        pages = claimed = ok = failed = 0\n201\t        llm = Outcome()\n202\t        status: RunStatus = \"failed\"\n203\t        error: str | None = None\n204\t        # Circuit breaker живёт один заход (design §5.5): провайдер, лежавший\n205\t        # час назад, к этому часу мог подняться, и новый заход обязан попробовать.\n206\t        self.llm.reset_breaker()\n207\t        try:\n208\t            selector = BatchSelector(self.client, self._cursors, self._processed)\n209\t            batch = await selector.next_batch(day, run_id)\n\n... [132 lines truncated] ..."},"type":"attachment","uuid":"06249af1-fb62-42e4-8488-1a52c8a9c89d","timestamp":"2026-09-06T17:19:47.000Z","session_id":"5f8e1778-e48b-42dd-ae24-619dbd631c2d","userType":"external","entrypoint":"cli","cwd":"/Users/ivan/Desktop/testing_task","sessionId":"cb6b885e-d0f4-40ea-a391-04a22e6e389b","version":"2.1.263","gitBranch":"main"}
